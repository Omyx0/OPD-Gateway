{
  "name": "smart-opd-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx concurrently -n express,ml -c blue,magenta \"npx tsx watch src/server.ts\" \"python -m uvicorn ml.api.main:app --host 0.0.0.0 --port 8000 --reload\"",
    "dev:express": "npx tsx watch src/server.ts",
    "dev:ml": "python -m uvicorn ml.api.main:app --host 0.0.0.0 --port 8000 --reload",
    "seed": "npx tsx scripts/seed.ts",
    "seed:realtime": "npx tsx scripts/seed_realtime_queue.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "ml:train": "python ml/models/vitals_model.py",
    "ml:preprocess": "python ml/preprocessing/clean_triage.py"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.49.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.16.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
